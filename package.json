{
  "name": "humanoid-robotics-book",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "start-hf": "cross-env RAG_API_URL=https://abdulmanan04-fastapi-chatbot.hf.space docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "auth-server": "node auth-server.js",
    "backend": "cd backend/backend && python -c \"import os; os.chdir('E:/humanoid-robotics-book/backend/backend'); import sys; sys.path.insert(0, '.'); from main import app; import uvicorn; uvicorn.run(app, host='127.0.0.1', port=8009, log_level='info')\"",
    "dev": "concurrently \"npm run start\" \"npm run auth-server\"",
    "dev-hf": "concurrently \"npm run start-hf\" \"npm run auth-server\"",
    "dev-full": "concurrently \"npm run start\" \"npm run auth-server\" \"npm run backend\"",
    "dev-proxy": "REACT_APP_API_BASE_URL=http://localhost:8009 concurrently \"npm run start\" \"npm run auth-server\" \"npm run backend\"",
    "start-auth": "cross-env AUTH_PORT=8080 node auth-server.js",
    "start-auth-prod": "cross-env AUTH_PORT=8080 FRONTEND_URL=https://your-frontend-domain.com node auth-server.js",
    "build-hf": "cross-env RAG_API_URL=https://abdulmanan04-fastapi-chatbot.hf.space npm run build",
    "note": "Note: Direct connection to Hugging Face may have CORS issues in development. Consider deploying a proxy service for production."
  },
  "dependencies": {
    "@docusaurus/core": "3.1.0",
    "@docusaurus/preset-classic": "3.1.0",
    "@mdx-js/react": "^3.0.0",
    "axios": "^1.13.2",
    "better-auth": "^1.4.7",
    "better-sqlite3": "^12.5.0",
    "clsx": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "jsonwebtoken": "^9.0.3",
    "prism-react-renderer": "^2.3.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.1.0",
    "@docusaurus/types": "3.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
